# Copia este archivo a .env y rellena los valores reales.

# Desarrollo local con SQLite (se crea el archivo solo):
DATABASE_URL=sqlite:///./tripnest.db
# Alternativa con MySQL:
# DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/tripnest

# Clave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
